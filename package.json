{
  "name": "digistaybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/firestore.rules.test.ts",
    "test:emulators": "firebase emulators:exec --project demo-digistaybook --only firestore \"vitest run tests/firestore.rules.test.ts\"",
    "status:check": "node tools/verify-implementation-status.mjs",
    "functions:build": "npm --prefix functions run build",
    "check": "npm run status:check && npm run typecheck && npm run test && npm run build && npm run functions:build",
    "check:all": "npm run check && npm run test:emulators"
  },
  "dependencies": {
    "firebase": "^12.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "firebase-tools": "^15.25.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
