VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=true

# App Check attests requests to the privileged endpoints (reporting,
# moderation, contribution). Without it those calls are refused server-side.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Development only. localhost has no domain reCAPTCHA can attest, so a dev
# build talking to the real project is refused with 401 Unauthenticated. Set
# this to `true` once, read the debug token the console prints, register it
# under App Check -> Apps -> Manage debug tokens, then paste that token here.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# No Stripe key belongs in the browser bundle. Activation redirects to a
# Stripe-hosted Checkout URL created server-side, so Stripe.js is never
# loaded and there is no publishable key to configure. Reintroduce one only
# alongside embedded Checkout, together with the Stripe CSP directives.
