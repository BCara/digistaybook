    "rewrites": [
      { "source": "/wall/**", "destination": "/app.html" },
      { "source": "/stay/**", "destination": "/app.html" },
      { "source": "/embed/wall/**", "destination": "/app.html" },
      { "source": "/host", "destination": "/app.html" },
      { "source": "/host/**", "destination": "/app.html" },
      { "source": "/operations", "destination": "/app.html" },
      { "source": "/operations/**", "destination": "/app.html" },
      { "source": "/reset-password", "destination": "/app.html" },
      { "source": "/verify-email", "destination": "/app.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
        ]
      },
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "functions": { "source": "functions" },
  "firestore": { "rules": "firestore.rules", "indexes": "firestore.indexes.json" },
  "storage": { "rules": "storage.rules" },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 },
    "singleProjectMode": true
  }
}
