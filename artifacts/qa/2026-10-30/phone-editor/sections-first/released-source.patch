-/* Preview-led phone editor. The guest wall keeps its theme; controls use the host app's chrome. */
+/* Checklist first on a phone; the wall and its focused section forms share the saved profile. */
+.phone-wall-heading[hidden] { display: none; }
 .phone-wall-heading { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 18px 0; }
 .phone-wall-heading h2 { margin: 0; font-family: var(--font-display); font-size: 1.65rem; }
 .phone-wall-status { font-size: .8125rem; color: var(--text-muted); margin: 6px 0 0; }
@@ -26,10 +27,23 @@
 .phone-wall-summary > p:first-child { margin-top: 0; }
 .phone-wall-summary .stay-again { margin: 0; }
 .phone-wall-summary .stay-again .stay-section-title { display: none; }
-.phone-wall-sections { display: grid; padding-bottom: 20px; }
-.phone-wall-sections > button { display: flex; width: 100%; text-align: left; justify-content: space-between; border: 0; border-bottom: 1px solid var(--rule); background: transparent; color: var(--text); border-radius: 0; padding: 18px 8px; gap: 16px; min-height: 78px; }
-.phone-wall-sections b { display: block; font-weight: 600; }
-.phone-wall-sections small { display: block; font-size: .8125rem; color: var(--text-muted); margin-top: 4px; overflow-wrap: anywhere; }
+.phone-wall-sections { display: grid; grid-template-columns: minmax(0, 1fr); margin: 4px 0 20px; border: 1px solid var(--rule); border-radius: 16px; overflow: hidden; background: var(--surface-raised); }
+.phone-wall-sections > button { display: flex; width: 100%; min-width: 0; box-sizing: border-box; text-align: left; align-items: center; border: 0; background: transparent; color: var(--text); border-radius: 0; padding: 12px 14px; gap: 13px; min-height: 72px; }
+.phone-wall-sections > button + button { border-top: 1px solid var(--rule); }
+.phone-wall-sections > button:hover { background: var(--bg-alt); }
+.phone-wall-sections > button:focus-visible { outline-offset: -3px; }
+.phone-section-mark { display: grid; place-content: center; flex: none; width: 32px; height: 32px; box-sizing: border-box; border-radius: 50%; font-size: 1rem; font-weight: 600; }
+.phone-wall-sections [data-state="done"] .phone-section-mark { background: var(--sage-050); color: var(--sage-700); }
+.phone-wall-sections [data-state="todo"] { background: color-mix(in srgb, var(--accent-soft) 55%, transparent); }
+.phone-wall-sections [data-state="todo"] .phone-section-mark { border: 2px solid var(--accent); color: var(--accent-strong); }
+.phone-wall-sections [data-state="todo"] small { color: var(--accent-strong); }
+.phone-wall-sections [data-state="optional"] .phone-section-mark { border: 2px dashed var(--rule-strong); color: var(--text-muted); }
+.phone-wall-sections [data-state="off"] .phone-section-mark { background: var(--bg-alt); color: var(--text-muted); }
+.phone-section-words { flex: 1; min-width: 0; }
+.phone-section-optional { font-weight: 400; color: var(--text-muted); }
+.phone-section-chevron { flex: none; color: var(--text-muted); font-size: 1.5rem; }
+.phone-wall-sections b { display: block; font-size: 1rem; font-weight: 600; }
+.phone-wall-sections small { display: block; font-size: .875rem; font-weight: 400; color: var(--text-muted); margin-top: 4px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
 .phone-wall-dock { position: fixed; bottom: 0; left: 0; right: 0; z-index: 16; display: grid; gap: 8px; padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px)); border-top: 1px solid var(--rule); background: var(--bg); }
 .phone-wall-dock > div { display: flex; gap: 10px; }
 .phone-wall-dock .btn { flex: 1; min-height: 48px; }
