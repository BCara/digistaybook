# Stripe credentials are NOT set here. Both are Secret Manager secrets, bound
# to the functions that declare them (see functions/src/stripeConfig.ts):
#   firebase functions:secrets:set STRIPE_RESTRICTED_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# The key is a restricted key (rk_), never a secret key (sk_). A live key must
# never appear in this file, in any .env, or in the repository.

# Not secret, and per-project so a test deployment cannot reach the live
# catalogue. Set in .env.<project>, not here.
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
# Origin the host returns to after hosted checkout, no trailing slash.
APP_URL=https://

# Keep disabled until GC-01..GC-08 in docs/guest-contribution-issues.md are resolved.
GUEST_CONTRIBUTIONS_ENABLED=false
# Dedicated private buckets, never the existing host-photo bucket.
GUEST_QUARANTINE_BUCKET=
GUEST_PUBLISHED_BUCKET=
# Explicitly approved bucket for legacy post path manifests; never guessed.
LEGACY_MEDIA_BUCKET=
