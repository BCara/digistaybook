# Per-project Stripe config for the `digistaybook-cbert` Firebase project.
# Loaded on top of functions/.env by Firebase Functions.
#
# These are NOT secrets (see docs/stripe-integration-plan.md §9): price ids and
# the return origin are public identifiers, so they are version-controlled per
# project. Keeping them here — not in functions/.env — is what makes it
# impossible to point this deployment at a different catalogue by accident.
#
# The restricted key (STRIPE_RESTRICTED_KEY) and the webhook signing secret
# (STRIPE_WEBHOOK_SECRET) are Secret Manager secrets and never appear in any
# .env file. Set them with `firebase functions:secrets:set`.

# DigiStayBook sandbox catalogue (acct_1UDAcoE6RXRx7LYa). One Product
# (prod_VDgefH6xk8OXHp). These two recurring Prices were created 30 Oct 2026
# (D-027) in AUD with USD, GBP and EUR currency_options — A$15/A$150,
# US$10/US$100, £8/£80, €9/€90 — and no tax_behavior (account default is
# inferred_by_currency). Stripe will not add currencies to a Price that has been
# used, so they replace the 8 Sep 2026 AUD + USD Prices (ST-01:
# price_1UDFHNE6RXRx7LYaR5bQPPOg / price_1UDFHSE6RXRx7LYavuue90cL), which stay
# active for the subscriptions already on them.
STRIPE_PRICE_MONTHLY=price_1UW6EZE6RXRx7LYaYMGUuF4E
STRIPE_PRICE_ANNUAL=price_1UW6ElE6RXRx7LYazGHvzOmm

# Origin a host returns to after hosted checkout, no trailing slash.
# Default Firebase Hosting URL for this project; change if a custom domain is added.
APP_URL=https://digistaybook.com

# Dedicated private guest-media buckets in australia-southeast1. Both have
# uniform bucket access and public-access prevention enforced.
GUEST_QUARANTINE_BUCKET=digistaybook-cbert-guest-quarantine
GUEST_PUBLISHED_BUCKET=digistaybook-cbert-guest-published

# Counsel approval and live memory-screening decisions remain open, so the
# approved switch stays false. The owner chose on 11 Oct 2026 to open guest
# intake on every property anyway; this override is not legal approval.
GUEST_CONTRIBUTIONS_ENABLED=false
GUEST_INTAKE_OWNER_OVERRIDE=true
GUEST_TEST_PROPERTY_IDS=
GUEST_TEST_UNTIL=

# Where "Message us" support requests from the help guide are sent (docs/help-chat.md).
HELP_SUPPORT_EMAIL=codebertcreations@gmail.com
